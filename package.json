{
  "name": "coproxy",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Linux 代理网关的配置与可靠性集成",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "cli": "node --experimental-strip-types apps/cli/main.ts",
    "typecheck": "node tooling/node_modules/typescript/bin/tsc -p tsconfig.json",
    "test:config": "node --experimental-strip-types --test tests/config.test.ts",
    "test:transaction": "node --experimental-strip-types --test tests/transaction.test.ts",
    "test:drafts": "node --experimental-strip-types --test tests/drafts.test.ts",
    "test:subscriptions": "node --experimental-strip-types --test tests/subscriptions.test.ts tests/subscription-http.test.ts",
    "test:mihomo": "node --experimental-strip-types --test tests/mihomo.test.ts",
    "test:cli": "node --experimental-strip-types --test tests/cli.test.ts",
    "test:runtime": "node --experimental-strip-types --test tests/runtime-evidence.test.ts tests/runtime-plan.test.ts tests/runtime-systemd.test.ts"
  }
}
