[Unit]
Description=CoCoProxy LAN HTTPS management entry
After=network-online.target cocoproxy-management.service
Wants=network-online.target
Requires=cocoproxy-management.service

[Service]
Type=simple
# Match the dedicated account selected in the deployment input.
User=cocoproxy
Group=cocoproxy
ExecStart=/usr/sbin/nginx -c /etc/cocoproxy/web/nginx.conf -g "daemon off;"
Restart=on-failure
RestartSec=2
RuntimeDirectory=cocoproxy-web
RuntimeDirectoryMode=0700
StateDirectory=cocoproxy-web
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/cocoproxy-web /run/cocoproxy-web

[Install]
WantedBy=multi-user.target
